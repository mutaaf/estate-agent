__pycache__/
*.pyc
.DS_Store
.agent/.local/
estate/cache/
site/_build/
.venv/

# Scan output is generated; it embeds the absolute path of whoever ran it,
# which must never reach a public commit. tests/test_publishable.py enforces
# this. The leading slash matters: unanchored, `estate/` also matches
# tests/fixtures/estate/ and quietly excludes the fixture that proves the
# map's precision.
/estate/
/ESTATE.md

# Generated site output
_site/

# Scan output written inside the fixture. concepts.yaml is curated and
# stays tracked; these are generated and embed an absolute path.
tests/fixtures/estate/estate/graph.json
tests/fixtures/estate/estate/estate.yaml
tests/fixtures/estate/ESTATE.md
tests/fixtures/estate/vault/

# Your organisation's internal names, for the publish-safety check. Never
# committed: writing them down in a public repo to check for them would be
# the leak. See tests/test_publishable.py::private_terms.
.publish-denylist
